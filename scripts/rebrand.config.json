{
  "$schema": "https://json.schemastore.org/json",
  "upstream": {
    "remote": "upstream",
    "url": "https://github.com/anomalyco/opencode.git",
    "packagePath": "packages/opencode",
    "rebrandedPackagePath": "packages/railwise"
  },
  "protectedPaths": [
    ".git",
    ".github",
    ".railwise",
    ".turbo",
    ".worktrees",
    "dist",
    "node_modules",
    "patches",
    "playground",
    "refs",
    "scripts",
    "skill-pack-template",
    "target",
    "tmp"
  ],
  "textReplacements": [
    {
      "from": "OPENCODE",
      "to": "RAILWISE"
    },
    {
      "from": "OpenCode",
      "to": "RAILWISE"
    },
    {
      "from": "opencode.ai",
      "to": "railwise.ai"
    },
    {
      "from": "opencode.com",
      "to": "railwise.ai"
    },
    {
      "from": ".opencode",
      "to": ".railwise"
    },
    {
      "from": "@opencode-ai",
      "to": "@railwise"
    },
    {
      "from": "opencode-ai",
      "to": "railwise-ai"
    },
    {
      "from": "opencode",
      "to": "railwise"
    }
  ],
  "pathReplacements": [
    {
      "from": "opencode",
      "to": "railwise"
    },
    {
      "from": "OpenCode",
      "to": "RAILWISE"
    },
    {
      "from": "OPENCODE",
      "to": "RAILWISE"
    }
  ],
  "binaryExtensions": [
    ".bmp",
    ".gif",
    ".icns",
    ".ico",
    ".jpg",
    ".jpeg",
    ".lockb",
    ".pdf",
    ".png",
    ".woff",
    ".woff2",
    ".zip"
  ]
}
